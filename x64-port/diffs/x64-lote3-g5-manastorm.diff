     // FUN_102a6c10: the objective-icon geometry constants in the client's .rdata.
     void SetObjectiveIconScale(float s)
     {
+#if ASC_X64
+        // PlayerName.cpp s_iconPositions (C3Vector[4], no pointers): one block in .data on x64 too, but only its
+        // start 0xAF46AC is mapped -- the others are offsets from it.
+        float* v = static_cast<float*>(ASC_PTR(0xAF46AC));
+        if (!v)
+            return;
+        v[0] = s * -0.5f;   // [0].x  0xAF46AC
+        v[1] = s;           // [0].y  0xAF46B0
+        v[3] = s * 0.5f;    // [1].x  0xAF46B8
+        v[4] = s;           // [1].y  0xAF46BC
+        v[6] = s * 0.5f;    // [2].x  0xAF46C4
+        v[9] = s * -0.5f;   // [3].x  0xAF46D0
+        return;
+#endif
         WriteProtected<float>(0xAF46AC, s * -0.5f);
         WriteProtected<float>(0xAF46B0, s);
         WriteProtected<float>(0xAF46B8, s * 0.5f);
@@ -399,8 +416,13 @@ namespace
     void SetSpellRangeFlags(uint32_t flags)   // FUN_100b2590 rows 0x72 / 0x1BD, +0x14
     {
         for (uint32_t id : {0x72u, 0x1BDu})
+#if ASC_X64
+            if (uint32_t* field = AscClientDbc::Field(0xAD4988, id, 0x14))   // Row is a copy on x64
+                *field = flags;
+#else
             if (const uint8_t* row = ClientDbcRow(0xAD4988, id))
                 *reinterpret_cast<uint32_t*>(const_cast<uint8_t*>(row) + 0x14) = flags;
+#endif
     }
 
