# Copie para local.env (nao versionado) e preencha.
# COA_WORK=/caminho/da/raiz/de/trabalho     # padrao: tres niveis acima de x64-port/ci
# Maquina Windows de build (MSVC x64, ssh + PowerShell)
WIN_HOST=
WIN_USER=
WIN_PASS=
# Hipervisor que liga a maquina de build se ela estiver desligada (opcional; qm start)
HV_HOST=
HV_VMID=
SSH_KEY=~/.ssh/id_ed25519
# Maquina de teste (publicacao e coleta da bateria)
PC_HOST=
PC_PORT=22
PC_DIR=
# URL base da loja do servidor (botao Web Shop do Wardrobe; vazio = site do Ascension)
COA_SHOP_URL=
# Pasta do fonte do cliente na maquina Windows de build (ex.: D:/build/<pasta>)
WIN_SRC_DIR=
