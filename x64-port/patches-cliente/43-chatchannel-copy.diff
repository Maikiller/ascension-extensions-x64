+#if defined(_WIN64)
+// 43: TSGrowableArray<ChatChannel>::ReallocData (s_channels.SetCount ao entrar
+// no canal N > m_count) copia cada canal e destroi o antigo; o SMemReAlloc
+// reconstruido devolve nullptr com SMEM_FLAG_NOREALLOC, entao a copia sempre
+// roda. O copy ctor do TSList so copia o offset: a lista nova nasce vazia e o
+// ~TSList do antigo so desliga os nos (vazam, e a lista de membros pendentes
+// do canal some). Mesmo layout do TSExplicitList; a copia MOVE os nos (Combine,
+// como no ChatFrame.cpp ao listar os pendentes).
+struct ChatPendingUserList : public TSExplicitList<PENDINGUSERLIST, 0> {
+    ChatPendingUserList() {
+    }
+    ChatPendingUserList(const ChatPendingUserList& source) : TSExplicitList<PENDINGUSERLIST, 0>() {
+        this->Combine(&const_cast<ChatPendingUserList&>(source), 2, nullptr);
+    }
+    ChatPendingUserList& operator=(const ChatPendingUserList&) = delete;
+};
+#endif
+
 class ChatChannel {
     public:
     /* 0000 */ int32_t m_channelNumber;
     /* 0004 */ char m_name[128];
+#if defined(_WIN64)
+    /* 0084 */ ChatPendingUserList m_pendingUsers;
+#else
     /* 0084 */ TSExplicitList<PENDINGUSERLIST, 0> m_pendingUsers;
+#endif
     /* 0090 */ uint8_t m_flags;
