+// CoA: Extensions.dll (sub_10a44df0 sobre 0x744150). Com a textura de seta (ObjectSelectionCircleTexture 2 ou 3,
+// CVar registrada pelo DLL) o circulo gira com o objeto: matriz identidade, -GetRenderFacing() (vtable +0x94 no x86)
+// e meia volta; senao, o original. No x86 o DLL lia o objeto do ecx que o chamador deixava (o this de quem desenha).
+void CGObject_C::CoaBuildSelectionRotMatrix(const CGObject_C* object, C44Matrix* matrix, const C3Vector* position) {
+    static CVar* s_circleTexture = nullptr;
+
+    if (!s_circleTexture) {
+        s_circleTexture = CVar::Lookup("ObjectSelectionCircleTexture");
+    }
+
+    if (object && object->m_obj && s_circleTexture && (s_circleTexture->m_intValue == 2 || s_circleTexture->m_intValue == 3)) {
+        *matrix = C44Matrix();
+        matrix->RotateAroundZ(-object->GetRenderFacing());
+        matrix->RotateAroundZ(3.14159274f);
+        return;
+    }
+
+    CGObject_C::BuildSelectionRotMatrix(matrix, position);
+}
